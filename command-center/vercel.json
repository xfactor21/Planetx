{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/events/config", "destination": "/api/_healthcheck?route=events/config" },
    { "source": "/api/events/authorize", "destination": "/api/_healthcheck?route=events/authorize" },
    { "source": "/api/analytics/website", "destination": "/api/_healthcheck?route=analytics/website" },
    { "source": "/api/products/visualx/analytics", "destination": "/api/_healthcheck?route=products/visualx/analytics" },
    { "source": "/api/apps/analytics", "destination": "/api/_healthcheck?route=apps/analytics" },
    { "source": "/api/google/overview", "destination": "/api/_healthcheck?route=google/overview" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
