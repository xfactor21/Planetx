# Required for the beta application form to send emails (app/api/beta-application/route.ts).
# Get a free API key at https://resend.com — no credit card needed for the free tier.
RESEND_API_KEY=

# planet.X command-center analytics. Keep the shared key server-side only.
PLANETX_ANALYTICS_INGEST_URL=
PLANETX_ANALYTICS_KEY=

# planet.X licensing gateway (app/api/license/route.ts)
# Keep all secrets server-side. Never place provider secrets inside extensions/apps.
LICENSE_ALLOWED_PRODUCTS=sessiongrid-x
LICENSE_GATEWAY_SECRET=

# Per-product provider selector. Supported values: payhip | lemon
LICENSE_SESSIONGRID_X_PROVIDER=payhip

# Payhip: create SessionGrid X as a digital product with unique license keys enabled.
# Product secret is shown on the product edit page after license keys are enabled.
PAYHIP_SESSIONGRID_X_PRODUCT_SECRET=
PAYHIP_SESSIONGRID_X_PRODUCT_LINK=
PAYHIP_SESSIONGRID_X_MAX_USES=3

# Lemon Squeezy fallback/alternate provider. These IDs are optional but recommended
# so a valid license from a different product cannot unlock SessionGrid X.
LEMON_SESSIONGRID_X_PRODUCT_ID=
LEMON_SESSIONGRID_X_VARIANT_ID=
