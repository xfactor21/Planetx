# Required for the beta application form to send emails (app/api/beta-application/route.ts).
# Get a free API key at https://resend.com — no credit card needed for the free tier.
RESEND_API_KEY=

# Optional — required only to log "get notified" signups (app/api/notify-signup/route.ts)
# to the Notion "Interested Users" database. Without this, signups still email you via
# Resend, they just won't be logged to Notion.
# Create an integration at https://www.notion.so/my-integrations, then share the
# "Interested Users" database (Website / Beta / Interested Users) with it.
NOTION_API_KEY=
